# App
NODE_ENV=development
PORT=3050
# Base URL used when building webhook/callback URLs
APP_BASE_URL=http://localhost:3050

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vireo
DB_SSL=false
# With DB_SSL=true the server certificate is verified. If your provider uses its
# own CA, set DB_SSL_CA to its PEM (or the PEM base64-encoded).
DB_SSL_CA=
# Local self-signed databases only: encrypts without verifying. Refused in production.
DB_SSL_INSECURE=false

# Auth
# Required, at least 32 random characters (no default): openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300
# Interim, until SMS delivery exists: writes each OTP to the server log so you can
# log in locally. The code is never returned by the API. Startup refuses this in production.
OTP_LOG_CODE=false
CHALLENGE_TTL_SECONDS=120
# Comma-separated phones granted the admin role at registration (KYC/KYB review).
ADMIN_PHONES=
# Shared secret for POST /internal/reconciliation/run. Endpoint is disabled when empty.
INTERNAL_API_TOKEN=

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Paga (sandbox for MVP)
# Sandbox: https://beta.mypaga.com/paga-webservices/business-rest/secured | https://beta-collect.paga.com
# Live:    https://www.mypaga.com/paga-webservices/business-rest/secured  | https://collect.paga.com
PAGA_BUSINESS_BASE_URL=https://beta.mypaga.com/paga-webservices/business-rest/secured
PAGA_COLLECT_BASE_URL=https://beta-collect.paga.com
# Public Key, Secret Key, and Hash Key from the Paga developer portal.
PAGA_API_KEY=
PAGA_API_SECRET=
PAGA_HASH_KEY=
# Optional fallback for the hash key (older env files).
PAGA_WEBHOOK_SECRET=

# Risk defaults (minor units, i.e. kobo)
RISK_TIER0_DAILY_LIMIT=2000000
RISK_TIER1_DAILY_LIMIT=5000000
RISK_TIER2_DAILY_LIMIT=20000000
RISK_TIER3_DAILY_LIMIT=500000000
# Wallet balance cap per tier in kobo (0 = no cap). Money above the cap is accepted but restricted
# (cannot be spent or transferred) until the user verifies more of their identity.
RISK_TIER0_MAX_BALANCE=5000000
RISK_TIER1_MAX_BALANCE=30000000
RISK_TIER2_MAX_BALANCE=50000000
RISK_TIER3_MAX_BALANCE=0
# Business cash-out caps per verification level, in kobo (level 1 = owner verified, level 2 = CAC registration reviewed).
MERCHANT_LEVEL1_CASHOUT_DAILY_LIMIT=20000000
MERCHANT_LEVEL2_CASHOUT_DAILY_LIMIT=500000000
RISK_SINGLE_TRANSFER_LIMIT=10000000

# Notifications
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_SMS_GATEWAY_URL=
NOTIFICATIONS_SMS_API_KEY=
NOTIFICATIONS_SMS_SENDER_ID=Vireo
NOTIFICATIONS_PUSH_ENABLED=false

# Keys the hashes of users' 4-digit transaction PINs. REQUIRED, 32+ random characters, different from
# JWT_SECRET (openssl rand -base64 48). Keep it out of the database and back it up: changing it
# invalidates every PIN (users would have to reset theirs).
PIN_PEPPER=

# Biometrics (Phase 3)
BIOMETRIC_MIN_MATCH_SCORE=75
BIOMETRIC_STEP_UP_MATCH_SCORE=85
BIOMETRIC_MIN_LIVENESS_SCORE=70
BIOMETRIC_MAX_SPOOF_SCORE=30
BIOMETRIC_MIN_QUALITY_SCORE=60
BIOMETRIC_STEP_UP_AMOUNT_MINOR=5000000

# Biometrics (face only). Leave BIOMETRIC_PROVIDER empty to keep biometrics
# disabled (every biometric operation fails closed). To enable face payments:
#   BIOMETRIC_PROVIDER=didit
#   BIOMETRIC_ENCRYPTION_KEY=<32 random bytes, base64>   e.g. openssl rand -base64 32
#   DIDIT_API_KEY=<from the Didit console>
#   DIDIT_KEY_TYPE=live | sandbox
# KEEP BIOMETRIC_ENCRYPTION_KEY SAFE and backed up: losing it makes every stored
# face reference unreadable (users must re-enroll). Never change it casually.
# DIDIT_KEY_TYPE=sandbox is for development only: Didit sandbox keys approve every
# face. The app refuses to start in production with a sandbox key.
BIOMETRIC_PROVIDER=
BIOMETRIC_ENCRYPTION_KEY=
DIDIT_API_KEY=
DIDIT_KEY_TYPE=
# Optional overrides
# DIDIT_BASE_URL=https://verification.didit.me/v3
# DIDIT_TIMEOUT_MS=15000

# KYC. Leave KYC_PROVIDER empty to disable automatic BVN verification (the
# endpoint answers 503). To enable Tier 1 (BVN) verification through Didit:
#   KYC_PROVIDER=didit
#   KYC_ENCRYPTION_KEY=<32 random bytes, base64>   e.g. openssl rand -base64 32
# Needs DIDIT_API_KEY / DIDIT_KEY_TYPE above. KYC_ENCRYPTION_KEY encrypts stored BVNs
# and keys the one-BVN-per-account hash: back it up, never reuse BIOMETRIC_ENCRYPTION_KEY,
# and do not change it (users would have to re-verify). Each BVN check is billed by Didit.
KYC_PROVIDER=
KYC_ENCRYPTION_KEY=

# Document storage (ID photos, proof of address, CAC certificates). Leave DOCUMENT_STORAGE
# empty to disable uploads (endpoints answer 503). Files are encrypted by the API before
# they reach Backblaze and are only served back through the API; the bucket must stay PRIVATE.
#   DOCUMENT_STORAGE=b2
#   DOCUMENT_ENCRYPTION_KEY=<32 random bytes, base64>  (openssl rand -base64 32; distinct from the other keys;
#                                                       back it up: losing it makes every stored file unreadable)
#   B2_KEY_ID / B2_APPLICATION_KEY: an application key restricted to the one bucket (read, write, delete files)
#   B2_BUCKET_ID / B2_BUCKET_NAME: from the bucket's details page
DOCUMENT_STORAGE=
DOCUMENT_ENCRYPTION_KEY=
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=

# Agent chat (POST /agent/chat). Leave the key empty to disable the endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Logging. Every HTTP request is always logged (method, path, status, duration, user).
# These add detail and can expose personal data, so they are refused in production.
LOG_HTTP_BODIES=false   # also log redacted request bodies
LOG_LLM_PAYLOADS=false  # log full OpenAI request/response content
