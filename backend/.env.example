# App
NODE_ENV=development
PORT=3050
# Base URL used when building webhook/callback URLs
APP_BASE_URL=http://localhost:3050

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vireo
DB_SSL=false
# With DB_SSL=true the server certificate is verified. If your provider uses its
# own CA, set DB_SSL_CA to its PEM (or the PEM base64-encoded).
DB_SSL_CA=
# Local self-signed databases only: encrypts without verifying. Refused in production.
DB_SSL_INSECURE=false

# Auth
# Required, at least 32 random characters (no default): openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300
# Interim, until SMS delivery exists: writes each OTP to the server log so you can
# log in locally. The code is never returned by the API. Startup refuses this in production.
OTP_LOG_CODE=false
CHALLENGE_TTL_SECONDS=120
# Comma-separated phones granted the admin role at registration (KYC/KYB review).
ADMIN_PHONES=
# Shared secret for POST /internal/reconciliation/run. Endpoint is disabled when empty.
INTERNAL_API_TOKEN=

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Paga (sandbox for MVP)
# Sandbox: https://beta.mypaga.com/paga-webservices/business-rest/secured | https://beta-collect.paga.com
# Live:    https://www.mypaga.com/paga-webservices/business-rest/secured  | https://collect.paga.com
PAGA_BUSINESS_BASE_URL=https://beta.mypaga.com/paga-webservices/business-rest/secured
PAGA_COLLECT_BASE_URL=https://beta-collect.paga.com
# Public Key, Secret Key, and Hash Key from the Paga developer portal.
PAGA_API_KEY=
PAGA_API_SECRET=
PAGA_HASH_KEY=
# Optional fallback for the hash key (older env files).
PAGA_WEBHOOK_SECRET=

# Risk defaults (minor units, i.e. kobo)
RISK_TIER0_DAILY_LIMIT=2000000
RISK_TIER1_DAILY_LIMIT=5000000
RISK_TIER2_DAILY_LIMIT=20000000
RISK_SINGLE_TRANSFER_LIMIT=10000000

# Notifications
NOTIFICATIONS_SMS_ENABLED=false
NOTIFICATIONS_SMS_GATEWAY_URL=
NOTIFICATIONS_SMS_API_KEY=
NOTIFICATIONS_SMS_SENDER_ID=Vireo
NOTIFICATIONS_PUSH_ENABLED=false

# Biometrics (Phase 3)
BIOMETRIC_MIN_MATCH_SCORE=75
BIOMETRIC_STEP_UP_MATCH_SCORE=85
BIOMETRIC_MIN_LIVENESS_SCORE=70
BIOMETRIC_MAX_SPOOF_SCORE=30
BIOMETRIC_MIN_QUALITY_SCORE=60
BIOMETRIC_STEP_UP_AMOUNT_MINOR=5000000

# Biometrics. Leave BIOMETRIC_PROVIDER empty to keep biometrics disabled (every
# biometric operation fails closed). Naming a provider requires its adapter and
# a 32-byte base64 key for template encryption, e.g.:
#   openssl rand -base64 32
BIOMETRIC_PROVIDER=
BIOMETRIC_ENCRYPTION_KEY=

# Agent chat (POST /agent/chat). Leave the key empty to disable the endpoint.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Logging. Every HTTP request is always logged (method, path, status, duration, user).
# These add detail and can expose personal data, so they are refused in production.
LOG_HTTP_BODIES=false   # also log redacted request bodies
LOG_LLM_PAYLOADS=false  # log full OpenAI request/response content
