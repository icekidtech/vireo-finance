# App
NODE_ENV=development
PORT=3050
# Base URL used when building webhook/callback URLs
APP_BASE_URL=http://localhost:3050

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=vireo
DB_SSL=false

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
OTP_TTL_SECONDS=300
CHALLENGE_TTL_SECONDS=120

# Redis / BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379

# Paga (sandbox for MVP)
# Sandbox: https://beta.mypaga.com/paga-webservices/business-rest/secured | https://beta-collect.paga.com
# Live:    https://www.mypaga.com/paga-webservices/business-rest/secured  | https://collect.paga.com
PAGA_BUSINESS_BASE_URL=https://beta.mypaga.com/paga-webservices/business-rest/secured
PAGA_COLLECT_BASE_URL=https://beta-collect.paga.com
# Public Key, Secret Key, and Hash Key from the Paga developer portal.
PAGA_API_KEY=
PAGA_API_SECRET=
PAGA_HASH_KEY=
# Optional fallback for the hash key (older env files).
PAGA_WEBHOOK_SECRET=

# Risk defaults (minor units, i.e. kobo)
RISK_TIER0_DAILY_LIMIT=2000000
RISK_TIER1_DAILY_LIMIT=5000000
RISK_TIER2_DAILY_LIMIT=20000000
RISK_SINGLE_TRANSFER_LIMIT=10000000

# Email notifications (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@vireofinance.com

# OpenAI LLM (agent chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Play Integrity (device attestation)
GOOGLE_PLAY_INTEGRITY_API_KEY=
